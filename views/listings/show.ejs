<%- layout('/layouts/boilerplate') %>

  <body>
    <div class="s-container">
      <h1 class="mb-3">
        <a href="/listings" class="btn btn-outline-secondary">← Back to Listings</a>
      </h1>

      <div class="row justify-content-center">
        <div class="col-md-6">
          <div class="listing-card">
            <b>
              <h3>
                <%= Listing.title %>
              </h3>
            </b>
            <img src="<%= Listing.image.url %>" class="card-img-top" alt="Hotel Image">
            <div class="card-body">
              <p class="card-text">Owned by <%= Listing.owner.username %>
              </p>
              <p class="card-text">
                <%= Listing.description %>
              </p>
              <div class="listing-details">
                <ul>
                  <li><strong>Price:</strong>
                    <%= Listing.price.toLocaleString("en-IN") %>/Night
                  </li>
                  <li><strong>Location:</strong>
                    <%= Listing.location %>
                  </li>
                  <li><strong>Country:</strong>
                    <%= Listing.country %>
                  </li>
                </ul>
              </div>
              <% if(currUser && currUser._id.equals(Listing.owner._id)) {%>
                <div class="button-group">
                  <form action="/listings/<%= Listing._id %>?_method=DELETE" method="POST">
                    <button class="btn btn-danger">Delete This Hotel!</button>
                  </form>
                  <a href="/listings/<%= Listing._id %>/edit" class="btn btn-primary">EDIT</a>
                </div>
                <%}%>
            </div>
          </div>
        </div>
      </div>
      <hr>
      <% if (currUser) { %>
        <div class="col-8 mb-3 offset-4">
          <h4>Leave a Review</h4>
          <form class="mb-3 col-8 needs-validation" action="/listings/<%= Listing._id %>/reviews" method="POST"
            novalidate>
            <fieldset class="starability-basic">
              <label for="rating" class="form-label">Rating</label>
              <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked
                aria-label="No rating." />
              <input type="radio" id="first-rate1" name="review[rating]" value="1" />
              <label for="first-rate1" title="Terrible">1 star</label>
              <input type="radio" id="first-rate2" name="review[rating]" value="2" />
              <label for="first-rate2" title="Not good">2 stars</label>
              <input type="radio" id="first-rate3" name="review[rating]" value="3" />
              <label for="first-rate3" title="Average">3 stars</label>
              <input type="radio" id="first-rate4" name="review[rating]" value="4" />
              <label for="first-rate4" title="Very good">4 stars</label>
              <input type="radio" id="first-rate5" name="review[rating]" value="5" />
              <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
            <div>
              <label for="comment" class="form-label">Comment</label>
              <textarea name="review[comment]" id="comment" cols="30" rows="10" class="form-control"
                required></textarea>
              <div class="invalid-feedback">please submit some comment</div>
            </div>
            <button type="submit" class="btn btn-outline-dark">Submit</button>
          </form>
        </div>
        <% } %>
          <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mt-3">
            <% for (let review of Listing.reviews) { %>
              <div class="col">
                <div class="card review-card border-0 shadow-sm h-100">
                  <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                      <div class="d-flex align-items-center mb-2">
                        <div
                          class="avatar bg-primary text-white rounded-circle me-2 d-flex justify-content-center align-items-center"
                          style="width: 40px; height: 40px; font-weight: 600;">
                          <%= review.author ? review.author.username[0] : "A" %>
                        </div>
                        <h5 class="card-title fw-semibold mb-0">
                          <%= review.author ? review.author.username : "Anonymous" %>
                        </h5>
                      </div>
                      <p class="card-text text-muted mb-3">
                        <%= review.comment %>
                      </p>
                      <p class="starability-result" data-rating="<%=review.rating%>"></p>
                    </div>
                    <% if(currUser && ( (review.owner && currUser._id.equals(review.owner._id)) || (Listing.owner &&
                      currUser._id.equals(Listing.owner._id)) )) { %>
                      <form action="/listings/<%= Listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST"
                        class="mt-3 text-end">
                        <button class="btn btn-outline-danger btn-sm px-3">
                          <i class="bi bi-trash"></i> Delete
                        </button>
                      </form>
                      <% } %>
                  </div>
                </div>
              </div>
              <% } %>
          </div>
    </div>
  </body>